{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": ["gui", "ground", "fixed", "on_shelf"],
        "model": { "type": "minecraft:model", "model": "larppture:item/golden_trident" }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_false": {
        "type": "minecraft:special",
        "base": "larppture:item/golden_trident_in_hand",
        "model": { "type": "minecraft:trident" }
      },
      "on_true": {
        "type": "minecraft:special",
        "base": "larppture:item/golden_trident_throwing",
        "model": { "type": "minecraft:trident" }
      }
    }
  }
}
